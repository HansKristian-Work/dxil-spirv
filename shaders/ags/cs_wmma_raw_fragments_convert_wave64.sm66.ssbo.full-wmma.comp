RWByteAddressBuffer Outputs : register(u0);
ByteAddressBuffer Inputs : register(t0);
RWByteAddressBuffer MAGIC : register(u0, space2147420894);

#include "wmma_ags.h"

// In wave64 a 16x16 fragment holds 4 elements per lane. The conversion of raw dwords needs no cooperative matrix.
[numthreads(64, 1, 1)]
[WaveSize(64)]
void main(uint thr : SV_GroupIndex)
{
	WMMA_Type F32Acc = WMMA_MakeType(WaveMatrixDataFormat_F32, WaveMatrixType_Accumulator, WaveMatrixShape_16X16, false);
	WMMA_Type F16Acc = WMMA_MakeType(WaveMatrixDataFormat_F16, WaveMatrixType_Accumulator, WaveMatrixShape_16X16, false);

	WMMA_Matrix C;
	[unroll] for (uint i = 0; i < 8; i++)
		C.v[i] = i < 3 ? asuint(asfloat(Inputs.Load(thr * 12 + 4 * i)) + 1.0) : 0u;

	WMMA_Matrix H = WMMA_Convert(F32Acc, F16Acc, C);
	Outputs.Store2(thr * 8, uint2(H.v[0], H.v[1] & 0xffff));
}
