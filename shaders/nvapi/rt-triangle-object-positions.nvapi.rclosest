#define NV_SHADER_EXTN_SLOT u127
#define NV_SHADER_EXTN_REGISTER_SPACE space0
#include "nvHLSLExtns.h"

struct Payload
{
	float3 vertex0;
	float3 vertex1;
	float3 vertex2;
};

[shader("closesthit")]
void RayHit(inout Payload payload, BuiltInTriangleIntersectionAttributes attr)
{
	float3x3 positions = NvRtTriangleObjectPositions();
	payload.vertex0 = positions[0];
	payload.vertex1 = positions[1];
	payload.vertex2 = positions[2];
}
