#define NV_SHADER_EXTN_SLOT u127
#define NV_SHADER_EXTN_REGISTER_SPACE space0
#include "nvHLSLExtns.h"

RaytracingAccelerationStructure RTAS : register(t0);
RWStructuredBuffer<bool> RWBool : register(u1);
RWStructuredBuffer<float> RWFloat : register(u2);

[numthreads(64, 1, 1)]
void main(uint thr : SV_GroupIndex)
{
	RayQuery<RAY_FLAG_CULL_NON_OPAQUE> q;
	RayDesc ray;
	ray.Origin = float3(1, 2, 3);
	ray.TMin = 4;
	ray.Direction = float3(5, 6, 7);
	ray.TMax = 8;
	q.TraceRayInline(RTAS, RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH, 0xaa, ray);

	while (q.Proceed())
	{
		RWBool[4 * thr + 0] = NvRtCandidateIsNonOpaqueLss(q);
		RWBool[4 * thr + 2] = NvRtCandidateIsNonOpaqueSphere(q);
		float2x4 position_and_radii = NvRtCandidateLssObjectPositionsAndRadii(q);
		RWFloat[0] = position_and_radii[0][0];
		RWFloat[1] = position_and_radii[0][1];
		RWFloat[2] = position_and_radii[0][2];
		RWFloat[3] = position_and_radii[0][3];
		RWFloat[4] = position_and_radii[1][0];
		RWFloat[5] = position_and_radii[1][1];
		RWFloat[6] = position_and_radii[1][2];
		RWFloat[7] = position_and_radii[1][3];

		float4 sphere = NvRtCandidateSphereObjectPositionAndRadius(q);
		RWFloat[8] = sphere.x;
		RWFloat[9] = sphere.y;
		RWFloat[10] = sphere.z;
		RWFloat[11] = sphere.w;

		q.Abort();
	}

	if (q.CommittedStatus())
	{
		float4 sphere = NvRtCommittedSphereObjectPositionAndRadius(q);
		RWFloat[8] = sphere.x;
		RWFloat[9] = sphere.y;
		RWFloat[10] = sphere.z;
		RWFloat[11] = sphere.w;

		RWBool[4 * thr + 1] = NvRtCommittedIsLss(q);
		float2x4 position_and_radii = NvRtCommittedLssObjectPositionsAndRadii(q);
		RWFloat[0] = position_and_radii[0][0];
		RWFloat[1] = position_and_radii[0][1];
		RWFloat[2] = position_and_radii[0][2];
		RWFloat[3] = position_and_radii[0][3];
		RWFloat[4] = position_and_radii[1][0];
		RWFloat[5] = position_and_radii[1][1];
		RWFloat[6] = position_and_radii[1][2];
		RWFloat[7] = position_and_radii[1][3];
	}
}
